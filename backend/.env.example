# Postgres connection string (Neon/Supabase). Leave empty locally to use a SQLite file.
DATABASE_URL=
# Long random string used to sign login tokens
JWT_SECRET=
# Any OpenAI-compatible LLM. Default: Groq free tier (https://console.groq.com/keys)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Demo accounts created on startup if they don't exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
